<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>UndeadLegacyPanels</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GameInstallDir Condition="'$(GameInstallDir)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">C:\Program Files (x86)\Steam\steamapps\common\7 Days To Die</GameInstallDir>
    <GameInstallDir Condition="'$(GameInstallDir)' == '' AND $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/7 Days To Die</GameInstallDir>
    <GameInstallDir Condition="'$(GameInstallDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/7 Days To Die</GameInstallDir>
    <!-- A dedicated server install names its data folder 7DaysToDieServer_Data; the client
         uses 7DaysToDie_Data. Probe for whichever exists under GameInstallDir. -->
    <GameDataDir Condition="Exists('$(GameInstallDir)/7DaysToDieServer_Data/Managed')">$(GameInstallDir)/7DaysToDieServer_Data</GameDataDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(GameInstallDir)/7DaysToDie_Data</GameDataDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game/mod assemblies this mod is built against - paths point at the reference install
         used during investigation (design doc §2). Override GameInstallDir to build elsewhere,
         e.g. `dotnet build /p:GameInstallDir="D:\some\other\path"`. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDataDir)/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(GameDataDir)/Managed/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utf8Json">
      <HintPath>$(GameDataDir)/Managed/Utf8Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WebServer">
      <HintPath>$(GameInstallDir)/Mods/TFP_WebServer/WebServer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDataDir)/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
